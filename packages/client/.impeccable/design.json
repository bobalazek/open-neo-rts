  "narrative": {
    "northStar": "Graphite Command Stations",
    "overview": "The normal match uses thin steel frames, warm metal command pictograms and original model portraits around a dominant battlefield. Dense, quiet controls support reading resources, inspecting real actor state and issuing orders. There is no decorative animation; minimap activity communicates game events.\n\nHome shares graphite steel, warm metal and original assets through native Babylon GUI. An original angular vector wordmark introduces an authored Dragon Tank on an octagonal plinth. Plain, framed actions sit beside the model on desktop and below it in portrait. Slow display rotation stops when reduced motion is requested.\n\nThis records the built Home and normal match. Other screens, including setup, settings, load, results and debug, retain older styling and are outside this system's current scope. The direction comes from the first body comment in `../../apps/web/index.html`; implementation evidence is `../render/src/scene/menu.ts`, `src/features/main-menu/index.ts`, `src/app/shell.css` and `src/features/match/`.",
    "keyCharacteristics": [
      "Battlefield first, with a slim resource strip and bottom command docks.",
      "Graphite surfaces, restrained brass highlights and tabular counters.",
      "Original brick models and original line pictograms.",
      "Narrow screens expose one dock through explicit panel tabs.",
      "Native Home actions, original vector lettering and an authored model display."
    ],
    "rules": [
      {
        "name": "The Battlefield Rule",
        "body": "Keep persistent controls at the viewport edges and leave the central canvas available for play.",
        "section": "layout"
      },
      {
        "name": "The Complete Recipe Rule",
        "body": "Keep every displayed resource amount and build time visible, and make unavailable reasons readable on desktop and mobile.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve the owner's original model assets and authored names.",
      "Do use real match state for portraits, counters, availability and feedback.",
      "Do preserve full recipe values and readable unavailable explanations.",
      "Do retain accessible action names, visible focus and narrow panel switching.",
      "Do keep native Home controls synchronized with semantic HTML and preserve the graphics fallback.",
      "Do honor reduced motion in the Home model display."
    ],
    "donts": [
      "Don't promote legacy setup, results or debug styling into Home or the match HUD.",
      "Don't substitute borrowed artwork or text glyphs for original model and SVG assets.",
      "Don't add ornamental animation that competes with battlefield activity."
    ]
  }
}
