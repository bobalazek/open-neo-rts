{
  "$schema": "../../../../schemas/structure.schema.json",
  "id": "structure:neutral/resource-extractor",
  "name": "Resource Extractor",
  "description": "Shared node-bound producer built by any faction. Produces materials or credits from oil; output halves in brownout and stops when powered off. Provisional balance. (Addition.)",
  "role": "extractor",
  "cost": { "credits": 800 },
  "buildTime": 20,
  "health": 800,
  "armor": "structure",
  "footprint": [2, 2],
  "nodeKinds": ["materials", "oil"],
  "extraction": {
    "materials": { "resource": "materials", "amountPerSecond": 1 },
    "oil": { "resource": "credits", "amountPerSecond": 2 }
  },
  "power": -10,
  "vision": 4,
  "presentation": {
    "model": "resource-extractor.glb",
    "icon": "resource-extractor.icon.png",
    "wreck": "resource-extractor.rubble.glb",
    "materials": {},
    "sockets": ["socket_smoke", "socket_healthbar"],
    "animations": ["idle", "active"]
  }
}
