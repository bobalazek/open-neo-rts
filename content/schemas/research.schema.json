{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "research",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^([a-z0-9-]+\\.)?research:[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "research ID"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
      "description": "locale key"
    },
    "description": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
      "description": "locale key"
    },
    "researchedAt": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9-]+\\.)?structure:[a-z0-9]+(-[a-z0-9]+)*$",
        "description": "structure ID"
      },
      "minItems": 1
    },
    "cost": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "propertyNames": {
        "pattern": "^([a-z0-9-]+\\.)?resource:[a-z0-9-]+$"
      }
    },
    "researchTime": {
      "type": "number",
      "minimum": 0,
      "maximum": 900,
      "description": "seconds"
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9-]+\\.)?[a-z]+:[a-z0-9]+(-[a-z0-9]+)*$",
        "description": "any definition ID"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "A typed effect. New effect types are engine features, never scripts.",
        "properties": {
          "$schema": {
            "type": "string"
          },
          "type": {
            "enum": [
              "modifyStat",
              "spawn",
              "damageArea",
              "reveal",
              "stealth",
              "disable",
              "heal",
              "grantResource"
            ]
          },
          "target": {
            "description": "self, area, or a { tags } filter"
          },
          "stat": {
            "type": "string"
          },
          "percent": {
            "type": "integer",
            "minimum": 0
          },
          "amount": {
            "type": "number"
          },
          "radius": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "pattern": "^([a-z0-9-]+\\.)?unit:[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "unit ID"
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "researchedAt",
    "cost",
    "researchTime",
    "effects"
  ],
  "additionalProperties": false
}
