{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "preset",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^([a-z0-9-]+\\.)?preset:[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "preset ID"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
      "description": "locale key"
    },
    "description": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
      "description": "locale key"
    },
    "forces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "$schema": {
            "type": "string"
          },
          "team": {
            "type": "string",
            "pattern": "^[A-H]$"
          },
          "seats": {
            "type": "array",
            "items": {
              "enum": [
                "human",
                "bot",
                "open"
              ]
            },
            "minItems": 1,
            "maxItems": 4
          },
          "faction": {
            "type": "string",
            "pattern": "^([a-z0-9-]+\\.)?faction:[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "faction ID"
          }
        },
        "required": [
          "team",
          "seats"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 8
    },
    "settings": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "forces",
    "settings"
  ],
  "additionalProperties": false
}
