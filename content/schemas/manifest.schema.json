{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "manifest",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "pack ID, equal to the folder name"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "engine": {
      "type": "string",
      "description": "supported engine version range"
    },
    "name": {
      "type": "string",
      "pattern": "^.{1,60}$",
      "description": "English name; translations go in locales/<lang>.json"
    },
    "description": {
      "type": "string",
      "pattern": "^.{1,400}$",
      "description": "English description"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "description": "semver range"
      },
      "propertyNames": {
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "optionalDependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "description": "semver range"
      },
      "propertyNames": {
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "conflicts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "description": "semver range of incompatible versions"
      },
      "propertyNames": {
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "gameplay": {
      "type": "boolean"
    },
    "files": {
      "type": "object",
      "description": "Every definition file the pack includes. The loader reads exactly these; unlisted files are an error.",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "factions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^factions\\/[a-z0-9-]+\\/faction\\.json$"
          }
        },
        "units": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^factions\\/[a-z0-9-]+\\/units\\/[a-z0-9-]+\\/unit\\.json$"
          }
        },
        "structures": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(factions\\/[a-z0-9-]+|neutral)\\/structures\\/[a-z0-9-]+\\/structure\\.json$"
          }
        },
        "props": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^props\\/[a-z0-9-]+\\/[a-z0-9-]+\\/prop\\.json$"
          }
        },
        "maps": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^maps\\/[a-z0-9-]+\\/map\\.json$"
          }
        },
        "campaigns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^campaigns\\/[a-z0-9-]+\\/campaign\\.json$"
          }
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^locales\\/[a-z]{2}(-[A-Z]{2})?\\.json$"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "version",
    "engine",
    "name",
    "description",
    "dependencies",
    "files"
  ],
  "additionalProperties": false
}
