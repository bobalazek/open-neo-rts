{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "weapon",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^([a-z0-9-]+\\.)?weapon:[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "weapon ID"
    },
    "damageType": {
      "type": "string",
      "pattern": "^[a-zA-Z]+$"
    },
    "damage": {
      "type": "integer",
      "minimum": 0
    },
    "range": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 60,
        "description": "cells"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "reload": {
      "type": "number",
      "minimum": 0,
      "maximum": 120,
      "description": "seconds"
    },
    "burst": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "projectile": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "hitscan",
            "direct",
            "ballistic",
            "homing",
            "beam",
            "delivered"
          ]
        },
        "speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 200,
          "description": "cells per second"
        },
        "turnRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "targets": {
      "type": "array",
      "items": {
        "enum": [
          "ground",
          "air",
          "naval",
          "structure",
          "projectile"
        ]
      },
      "minItems": 1
    },
    "splash": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "description": "cells"
        },
        "edgePercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "radius",
        "edgePercent"
      ],
      "additionalProperties": false
    },
    "socket": {
      "type": "string",
      "pattern": "^socket_[a-z]+$",
      "description": "muzzle socket on the carrier's model; defaults to socket_muzzle"
    }
  },
  "required": [
    "id",
    "damageType",
    "damage",
    "range",
    "reload",
    "projectile",
    "targets"
  ],
  "additionalProperties": false
}
