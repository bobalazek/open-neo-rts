{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ability",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^([a-z0-9-]+\\.)?ability:[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "ability ID"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
      "description": "locale key"
    },
    "description": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
      "description": "locale key"
    },
    "target": {
      "enum": [
        "self",
        "unit",
        "point",
        "area"
      ]
    },
    "range": {
      "type": "number",
      "minimum": 0,
      "maximum": 200,
      "description": "cells"
    },
    "cooldown": {
      "type": "number",
      "minimum": 0,
      "maximum": 3600,
      "description": "seconds"
    },
    "autoCast": {
      "type": "boolean"
    },
    "cost": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "propertyNames": {
        "pattern": "^([a-z0-9-]+\\.)?resource:[a-z0-9-]+$"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "A typed effect. New effect types are engine features, never scripts.",
        "properties": {
          "$schema": {
            "type": "string"
          },
          "type": {
            "enum": [
              "modifyStat",
              "spawn",
              "damageArea",
              "reveal",
              "stealth",
              "disable",
              "heal",
              "grantResource"
            ]
          },
          "target": {
            "description": "self, area, or a { tags } filter"
          },
          "stat": {
            "type": "string"
          },
          "percent": {
            "type": "integer",
            "minimum": 0
          },
          "amount": {
            "type": "number"
          },
          "radius": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "pattern": "^([a-z0-9-]+\\.)?unit:[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "unit ID"
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "target",
    "cooldown",
    "effects"
  ],
  "additionalProperties": false
}
