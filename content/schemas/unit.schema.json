{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unit",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^([a-z0-9-]+\\.)?unit:[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "unit ID"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
      "description": "locale key"
    },
    "description": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
      "description": "locale key"
    },
    "faction": {
      "type": "string",
      "pattern": "^([a-z0-9-]+\\.)?faction:[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "faction ID"
    },
    "family": {
      "enum": [
        "infantry",
        "vehicle",
        "aircraft",
        "naval"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "propertyNames": {
        "pattern": "^([a-z0-9-]+\\.)?resource:[a-z0-9-]+$"
      }
    },
    "buildTime": {
      "type": "number",
      "minimum": 0,
      "maximum": 600,
      "description": "seconds"
    },
    "producedBy": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9-]+\\.)?structure:[a-z0-9]+(-[a-z0-9]+)*$",
        "description": "structure ID"
      },
      "minItems": 1
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9-]+\\.)?[a-z]+:[a-z0-9]+(-[a-z0-9]+)*$",
        "description": "any definition ID"
      }
    },
    "health": {
      "type": "integer",
      "minimum": 1
    },
    "armor": {
      "enum": [
        "infantry",
        "light",
        "medium",
        "heavy",
        "aircraft",
        "naval",
        "structure"
      ]
    },
    "movement": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "domain": {
          "enum": [
            "foot",
            "wheeled",
            "tracked",
            "hover",
            "amphibious",
            "naval",
            "air"
          ]
        },
        "speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "description": "cells per second"
        },
        "turnRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600,
          "description": "degrees per second"
        }
      },
      "required": [
        "domain",
        "speed"
      ],
      "additionalProperties": false
    },
    "radius": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 8,
      "description": "collision radius in cells"
    },
    "vision": {
      "type": "number",
      "minimum": 0,
      "maximum": 40,
      "description": "cells"
    },
    "pop": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "weapons": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9-]+\\.)?weapon:[a-z0-9]+(-[a-z0-9]+)*$",
        "description": "weapon ID"
      }
    },
    "abilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9-]+\\.)?ability:[a-z0-9]+(-[a-z0-9]+)*$",
        "description": "ability ID"
      }
    },
    "turret": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "turnRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600,
          "description": "degrees per second"
        }
      },
      "required": [
        "turnRate"
      ],
      "additionalProperties": false
    },
    "harvest": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "capacity": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "capacity"
      ],
      "additionalProperties": false
    },
    "transport": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "slots"
      ],
      "additionalProperties": false
    },
    "eras": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9-]+\\.)?era:[a-z0-9]+(-[a-z0-9]+)*$",
        "description": "era ID"
      },
      "minItems": 1
    },
    "eraVariants": {
      "type": "object",
      "additionalProperties": {
        "description": "partial definition overriding fields for that era"
      },
      "propertyNames": {
        "pattern": "^([a-z0-9-]+\\.)?era:[a-z0-9-]+$"
      }
    },
    "presentation": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "model": {
          "type": "string",
          "pattern": "^assets\\/[a-z0-9/._-]+$",
          "description": "runtime model (.glb), relative to the pack"
        },
        "icon": {
          "type": "string",
          "pattern": "^assets\\/[a-z0-9/._-]+$",
          "description": "build-menu icon (.png)"
        },
        "wreck": {
          "type": "string",
          "pattern": "^assets\\/[a-z0-9/._-]+$",
          "description": "wreck model (.wreck.glb)"
        },
        "materials": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "palette",
              "team",
              "team_dark",
              "team_light",
              "team_emissive",
              "metal",
              "glass",
              "emissive"
            ]
          },
          "propertyNames": {
            "pattern": "^.+$"
          }
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 0
        },
        "sockets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^socket_[a-z]+$"
          },
          "minItems": 0
        },
        "animations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 0
        },
        "sounds": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^assets\\/[a-z0-9/._-]+$"
          }
        }
      },
      "required": [
        "model",
        "icon",
        "materials"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "faction",
    "family",
    "cost",
    "buildTime",
    "producedBy",
    "health",
    "armor",
    "movement",
    "radius",
    "vision",
    "pop",
    "weapons",
    "presentation"
  ],
  "additionalProperties": false
}
