{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "damage",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "armorClasses": {
      "type": "array",
      "items": {
        "enum": [
          "infantry",
          "light",
          "medium",
          "heavy",
          "aircraft",
          "naval",
          "structure"
        ]
      },
      "minItems": 1
    },
    "damageTypes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "propertyNames": {
          "pattern": "^[a-z]+$"
        }
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z]+$"
      }
    }
  },
  "required": [
    "armorClasses",
    "damageTypes"
  ],
  "additionalProperties": false
}
