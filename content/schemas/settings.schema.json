{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "settings",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "$schema": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z]+$"
          },
          "group": {
            "enum": [
              "caps",
              "economy",
              "speed",
              "combat",
              "vision",
              "victory",
              "teams",
              "bots",
              "modules"
            ]
          },
          "type": {
            "enum": [
              "integer",
              "enum",
              "boolean"
            ]
          },
          "default": {},
          "min": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "scope": {
            "type": "array",
            "items": {
              "enum": [
                "match",
                "faction",
                "force"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "group",
          "type",
          "default",
          "scope"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "settings"
  ],
  "additionalProperties": false
}
