{
  "$schema": "../../../schemas/settings.schema.json",
  "settings": [
    {
      "id": "popCap",
      "group": "caps",
      "type": "integer",
      "default": 200,
      "min": 50,
      "max": 500,
      "scope": ["match", "faction", "force"]
    },
    {
      "id": "structureCap",
      "group": "caps",
      "type": "integer",
      "default": 150,
      "min": 20,
      "max": 400,
      "scope": ["match", "faction", "force"]
    },
    {
      "id": "startingCredits",
      "group": "economy",
      "type": "integer",
      "default": 5000,
      "min": 0,
      "max": 50000,
      "scope": ["match", "force"]
    },
    {
      "id": "incomePercent",
      "group": "economy",
      "type": "integer",
      "default": 100,
      "min": 25,
      "max": 400,
      "scope": ["match", "force"]
    },
    {
      "id": "gameSpeed",
      "group": "speed",
      "type": "enum",
      "default": "normal",
      "options": ["slow", "normal", "fast", "faster"],
      "scope": ["match"]
    },
    {
      "id": "fog",
      "group": "vision",
      "type": "enum",
      "default": "standard",
      "options": ["standard", "explored", "off"],
      "scope": ["match"]
    },
    {
      "id": "victory",
      "group": "victory",
      "type": "enum",
      "default": "conquest",
      "options": [
        "conquest",
        "territory",
        "controlPoints",
        "economicDominance",
        "technicalSuperiority",
        "wonder",
        "score",
        "survival",
        "objectives"
      ],
      "scope": ["match"]
    },
    {
      "id": "elimination",
      "group": "victory",
      "type": "enum",
      "default": "annihilation",
      "options": ["annihilation", "baseDestruction", "headquarters", "capital"],
      "scope": ["match"]
    },
    {
      "id": "reconnectWindowSeconds",
      "group": "teams",
      "type": "integer",
      "default": 90,
      "min": 30,
      "max": 300,
      "scope": ["match"]
    },
    {
      "id": "takeover",
      "group": "teams",
      "type": "enum",
      "default": "bot",
      "options": ["bot", "eliminate", "pauseVote"],
      "scope": ["match"]
    }
  ]
}
