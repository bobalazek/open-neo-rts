{
  "name": "open-neo-rts",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:browsers": "playwright test",
    "check": "biome check .",
    "fix": "biome check --write .",
    "neo": "bun apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
