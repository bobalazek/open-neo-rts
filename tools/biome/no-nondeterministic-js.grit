// Bans JS APIs whose results differ between engines (JSC, V8, SpiderMonkey) or depend on the host.
// Applied to the determinism packages via biome.json overrides.
or {
  `Math.$fn` where {
    $fn <: or {
      `random`,
      `sin`,
      `cos`,
      `tan`,
      `asin`,
      `acos`,
      `atan`,
      `atan2`,
      `sinh`,
      `cosh`,
      `tanh`,
      `asinh`,
      `acosh`,
      `atanh`,
      `exp`,
      `expm1`,
      `log`,
      `log2`,
      `log10`,
      `log1p`,
      `cbrt`,
      `hypot`,
      `pow`
    },
    register_diagnostic(span=$fn, message="Not deterministic across JS engines. Use packages/deterministic (fixed-point, lookup trig, seeded PRNG).")
  },
  `$x.localeCompare($y)` as $call where {
    register_diagnostic(span=$call, message="Locale-dependent. Compare by code unit or by ID.")
  }
}
